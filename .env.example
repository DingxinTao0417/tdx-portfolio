# Public URL of the deployed site (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://tdx-portfolio.vercel.app

# --- Contact form delivery (optional) -------------------------------------
# Without RESEND_API_KEY the form still works: messages are logged server-side
# and the visitor is told delivery isn't configured yet.
# RESEND_API_KEY=re_xxxxxxxxx
# CONTACT_TO_EMAIL=taodingxin0417@gmail.com
# CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"

# --- GitHub (optional) -----------------------------------------------------
# Raises the GitHub API rate limit for the live "Recent commits" panel.
# GITHUB_TOKEN=ghp_xxxxxxxxx

# --- Supabase (admin area, contact inbox, page views, editable site data) ---
# Without these the site still builds and runs from the files in the repo; the admin area is off.
# The URL and publishable key are safe to expose to the browser.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Server-only secret key (Supabase > Settings > API Keys). Stores contact messages and page views.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# --- AI writing tools in the admin post editor (translate / polish) --------
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# Optional overrides:
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
