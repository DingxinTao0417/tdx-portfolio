# Public URL of the deployed site (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://tdx-portfolio.vercel.app

# --- Contact form delivery (optional) -------------------------------------
# Without RESEND_API_KEY the form still works: messages are logged server-side
# and the visitor is told delivery isn't configured yet.
# RESEND_API_KEY=re_xxxxxxxxx
# CONTACT_TO_EMAIL=taodingxin0417@gmail.com
# CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"

# --- GitHub (optional) -----------------------------------------------------
# Raises the GitHub API rate limit for the live "Recent commits" panel.
# GITHUB_TOKEN=ghp_xxxxxxxxx
